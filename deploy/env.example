# Template for /opt/nexus/.env. server-bootstrap.sh writes the real file with generated secrets;
# this copy has dummy values so CI can validate docker-compose.prod.yml. Never put real secrets here.
# A literal `$` in a value must be written `$$` (compose interpolation).
NEXUS_OWNER=example-owner
NEXUS_TAG=ci

POSTGRES_DB=ngac
POSTGRES_USER=ngac
POSTGRES_PASSWORD=dummy
REDIS_PASSWORD=dummy
JWT_SECRET=dummy
INTERNAL_IDENTITY_SECRET=dummy-internal-identity
MINIO_ROOT_USER=dummy
MINIO_ROOT_PASSWORD=dummy-dummy

APP_BASE_URL=https://nexus.zaneng.xyz
GOOGLE_REDIRECT_URL=https://nexus.zaneng.xyz/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign-in codes and workspace invitations by email through Gmail SMTP (one account serves the auth and
# workspace services). Leave SMTP_HOST empty to run without OTP sign-in and without invitation emails.
# SMTP_PASSWORD is a Gmail App Password (16 characters, no spaces), never the account password.
# SMTP_FROM must be the Gmail address itself or a verified alias. See docs/deployment.md.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# starttls (port 587, default) or tls (port 465).
SMTP_TLS=
