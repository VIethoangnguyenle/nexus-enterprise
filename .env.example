# =============================================================================
# NGAC Platform — Local Development Environment (template)
# =============================================================================
# Copy to .env.dev, which `make dev` sources. .env.dev is gitignored so local
# edits and real secrets never reach the repository.
#
#     cp .env.example .env.dev
#
# DO NOT use these values in production.
# =============================================================================

# --- Shared ---
DATABASE_URL=postgres://ngac:ngac_secret@localhost:5432/ngac?sslmode=disable
# The placeholder below is public — it is committed to this repository, so
# anyone can forge a token for any user with it. Services refuse to start with
# it unless APP_ENV marks the environment as development.
JWT_SECRET=ngac-super-secret-key-change-in-production

# Signs the identity tokens services send each other over gRPC. Every service
# must share the value, and it must differ from JWT_SECRET. Unset, a service
# falls back to a public placeholder, which is refused unless APP_ENV is a
# development value. For a rotation set INTERNAL_IDENTITY_SECRET_PREVIOUS to the
# old value: it is accepted for verification only.
# INTERNAL_IDENTITY_SECRET=
# INTERNAL_IDENTITY_SECRET_PREVIOUS=

# Marks this as a non-TLS environment, which drops the Secure attribute from the
# refresh-token cookie. Browsers discard Secure cookies over plain http, so
# without this the refresh flow silently stops working on http://localhost.
# Anything other than dev/development/local/test sets Secure — an unrecognised
# or unset value is treated as production on purpose.
APP_ENV=dev

# --- Redis (per-service DB index) ---
REDIS_URL_POLICY=redis://localhost:6379/0
REDIS_URL_AUTH=redis://localhost:6379/1
REDIS_URL_MESSAGING=redis://localhost:6379/2
REDIS_URL_ASSET=redis://localhost:6379/3

# --- Kafka ---
KAFKA_BROKERS=localhost:19092

# --- MinIO ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=ngac-admin
MINIO_SECRET_KEY=ngac-secret-key
MINIO_USE_SSL=false
MINIO_PUBLIC_ENDPOINT=localhost:9000

# --- gRPC Service Addresses (all on localhost) ---
# POLICY_SERVICE_ADDR is the one name for the policy address. The old POLICY_ADDR
# (approval only) is still read for one release and logs a deprecation warning.
POLICY_SERVICE_ADDR=localhost:50051
POLICY_READ_SERVICE_ADDR=localhost:50051
AUTH_SERVICE_ADDR=localhost:50052
WORKSPACE_SERVICE_ADDR=localhost:50053
DOCUMENT_SERVICE_ADDR=localhost:50054
MESSAGING_SERVICE_ADDR=localhost:50055
ASSET_SERVICE_ADDR=localhost:50056
DRIVE_SERVICE_ADDR=localhost:50057
APPROVAL_SERVICE_ADDR=localhost:50058

# --- REST Ports (unique per service for native dev) ---
AUTH_REST_PORT=8180
WORKSPACE_REST_PORT=8181
DOCUMENT_REST_PORT=8182
MESSAGING_REST_PORT=8183
ASSET_REST_PORT=8184
DRIVE_REST_PORT=8185
APPROVAL_REST_PORT=8186

# --- WebSocket ---
WS_PORT=8081

# --- Sign in with Google (auth service) ---
# Leave GOOGLE_CLIENT_ID empty to turn Google sign-in off: the login page hides
# the button and /api/auth/google/start answers 503.
# Create a "Web application" OAuth client in Google Cloud Console
# (APIs & Services → Credentials) and add GOOGLE_REDIRECT_URL, exactly as
# written here, to its "Authorized redirect URIs".
# Keep the real secret in .env.dev only (gitignored) — never commit it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Native dev goes through the Vite proxy on :5173, so the callback is the
# SPA origin + /api/auth/google/callback. docker-compose.yml does not read
# these two URLs; it defaults to Traefik on :80
# (http://localhost/api/auth/google/callback and http://localhost) and can be
# overridden with GOOGLE_REDIRECT_URL_DOCKER / APP_BASE_URL_DOCKER.
GOOGLE_REDIRECT_URL=http://localhost:5173/api/auth/google/callback
# Where the browser lands after Google sign-in (/auth/google/done) or after a
# failure (/login?error=...). Must be the origin that serves the SPA.
APP_BASE_URL=http://localhost:5173

# --- OTP sign-in (auth service) ---
# TEST-ONLY fixed code. While set to six digits, EVERY OTP sign-in accepts this
# code, for any email or phone — anyone who knows it can sign in as anyone.
# It proves nothing about the identifier, so OTP never auto-joins a tenant.
# Unset → defaults to 999999. Set it EMPTY (AUTH_FIXED_OTP_CODE=) to turn the
# test mode off: codes are then random, stored only as an HMAC, and delivered
# by a code sender. The only sender today writes the code to the auth log and
# runs only when APP_ENV=dev (or AUTH_DEV_OTP=1); with no sender, OTP sign-in
# is disabled (503, and the login page hides the form).
AUTH_FIXED_OTP_CODE=999999
# AUTH_DEV_OTP=1   # allow log delivery of random codes even when APP_ENV != dev
